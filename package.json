{
  "name": "dashboard",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm theme && vite dev",
    "build": "pnpm theme && vite build",
    "build:sb": "pnpm theme && storybook build",
    "preview": "pnpm build && vite preview --port 5173",
    "lint": "eslint",
    "theme": "smui-theme compile static/smui.css -i src/globalStyles -i node_modules/.pnpm/node_modules -i node_modules",
    "test": "vitest run",
    "check": "svelte-check && pnpm check:circular",
    "check:circular": "madge --circular --extensions ts,svelte src/",
    "check:visual": "madge --image deps.svg --extensions ts,svelte src/",
    "upgrade:core": "pnpm up '@aneuhold/*' --latest",
    "upgrade:smui": "pnpm up '@smui/*' '@smui-extra/*' smui-theme",
    "storybook": "pnpm theme && storybook dev -p 6006",
    "sub": "pnpm sub:core-ts-api-lib",
    "unsub": "local-npm unsubscribe",
    "sub:core-ts-api-lib": "local-npm subscribe @aneuhold/core-ts-api-lib",
    "sub:core-ts-db-lib": "local-npm subscribe @aneuhold/core-ts-db-lib",
    "sub:eslint-config": "local-npm subscribe @aneuhold/eslint-config",
    "unsub:core-ts-api-lib": "local-npm unsubscribe @aneuhold/core-ts-api-lib",
    "unsub:eslint-config": "local-npm unsubscribe @aneuhold/eslint-config"
  },
  "scriptsComments": {
    "theme": "This has the extra parameters for node_modules so it works with pnpm. Otherwise it fails when SASS tries to resolve imports."
  },
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "dependencies": {
    "@sentry/sveltekit": "^10.70.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@aneuhold/core-ts-api-lib": "^3.0.43",
    "@aneuhold/core-ts-db-lib": "^5.0.12",
    "@aneuhold/core-ts-lib": "^2.4.8",
    "@aneuhold/eslint-config": "^3.0.2",
    "@aneuhold/local-npm-registry": "^1.0.1",
    "@fontsource/fira-mono": "^5.3.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@smui-extra/accordion": "^9.0.2",
    "@smui-extra/autocomplete": "^9.0.2",
    "@smui/button": "^9.0.2",
    "@smui/card": "^9.0.2",
    "@smui/checkbox": "^9.0.2",
    "@smui/chips": "^9.0.3",
    "@smui/circular-progress": "^9.0.2",
    "@smui/common": "^9.0.2",
    "@smui/dialog": "^9.0.2",
    "@smui/drawer": "^9.0.2",
    "@smui/fab": "^9.0.2",
    "@smui/form-field": "^9.0.2",
    "@smui/icon-button": "^9.0.2",
    "@smui/list": "^9.0.2",
    "@smui/menu": "^9.0.2",
    "@smui/menu-surface": "^9.0.2",
    "@smui/paper": "^9.0.2",
    "@smui/segmented-button": "^9.0.2",
    "@smui/select": "^9.0.2",
    "@smui/snackbar": "^9.0.2",
    "@smui/textfield": "^9.0.2",
    "@smui/tooltip": "^9.0.2",
    "@smui/top-app-bar": "^9.0.2",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.5.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-storybook": "^10.5.8",
    "jsdom": "^30.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "smui-theme": "^9.0.3",
    "storybook": "^10.5.8",
    "svelte": "5.56.9",
    "svelte-check": "^4.7.6",
    "svelty-picker": "^6.1.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "devDependenciesComments": {
    "svelte": "Pinned to 5.53.0 because 5.54.0+ introduced a regression where SMUI Select/Option teardown calls querySelector on a null DOM element during Svelte's effect cleanup phase, causing 'Cannot read properties of null (reading querySelector)' errors. Pinned on 2026-03-26."
  }
}
